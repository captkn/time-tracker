@page "/time-tracker"
@rendermode InteractiveServer
@using TimeTracker.Models

<PageTitle>Time Tracker</PageTitle>

<h1>Time Tracker</h1>



@if (isRunning)
{
    <p>Working on: @taskName</p>
    <p>Phase: @phaseNumber</p>
    <p>Started: @startTime?.ToString("HH:mm:ss")</p>
    @if (elapsedTime.HasValue)
    {
        <p>Elapsed: @elapsedTime.Value.ToString(@"hh\:mm\:ss")</p>
    }

    <div>
        <button @onclick="StopTimer">Stop</button>
    </div>
}
else
{

    <div>
        <label>Task</label>
        <input @bind="taskName" />
    </div>

    <div>
        <label>Phase Number</label>
        <input @bind="phaseNumber" />
    </div>

    <div>
        <button @onclick="StartTimer">Start</button>
    </div>

    <p>No timer currently running.</p>

    @if (elapsedTime.HasValue)
    {
        <p>Last task took: @elapsedTime.Value.ToString(@"hh\:mm\:ss")</p>
    }

}

@code {

    private List<TimeEntry> timeEntries = new();

    private System.Threading.Timer? timer;

    private DateTime? startTime;
    private TimeSpan? elapsedTime;

    private string taskName = string.Empty;
    private string phaseNumber = string.Empty;
    private bool isRunning;

    private void StartTimer()
    {
        startTime = DateTime.Now;
        isRunning = true;

        timer = new System.Threading.Timer(
        _ => UpdateElapsedTime(),
        null,
        TimeSpan.Zero,
        TimeSpan.FromSeconds(1));
    }

    private void StopTimer()
    {
        DateTime endTime = DateTime.Now;

        timer?.Dispose();
        timer = null;

        if (startTime.HasValue)
        {
            var entry = new TimeEntry
            {
                TaskName = taskName,
                PhaseNumber = phaseNumber,
                StartTime = startTime.Value,
                EndTime = endTime
            };

            timeEntries.Add(entry);
            elapsedTime = DateTime.Now - startTime.Value;
        }
        
        isRunning = false;
    }

    private async void UpdateElapsedTime()
    {
        if (startTime.HasValue)
        {
            elapsedTime = DateTime.Now - startTime.Value;
            await InvokeAsync(StateHasChanged);
        }
    }
}